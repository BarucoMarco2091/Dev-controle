generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mongodb"
  url       = env("DATABASE_URL")

}

model Customer {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  phone String
  email String
  address String?
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())
  // cliente está relacionados com user
  userId String? @db.ObjectId
  User User? @relation(fields: [userId], references: [id])
  // customer pode ter vários tickets 
  tickets Ticket[]
}

model Ticket {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  description String
  status String
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())
  // relacionamentos entre tabelas
  // clientes está relacionado com ticket
  customerId String? @db.ObjectId
  // clientes está relacionado com ticket
  customer Customer? @relation(fields: [customerId], references: [id])
  // ticket está atrelado a usuario
  userId String? @db.ObjectId
  // User nome_do_modelo @relation(fields: [campo= userId], references[Ticketid])
  User User? @relation(fields: [userId], references: [id])
}

// adapter do nextauth
model User {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // 1 usuário pode ter varios tickets relacionados 
  tickets Ticket[]
  // usuário pode ter varios clientes 
  customers Customer[]
}
 
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}
 